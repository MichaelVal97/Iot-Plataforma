# MongoDB Configuration
# Use MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/iot_platform?retryWrites=true&w=majority
MONGODB_DATABASE=iot_platform
COLLECTION_READINGS=sensor_readings
COLLECTION_SENSORS=sensors

# BigQuery Data Warehouse (Google Cloud Sandbox)
BIGQUERY_PROJECT_ID=your-google-cloud-project-id
BIGQUERY_DATASET=iot_warehouse
BIGQUERY_LOCATION=US
# Autenticacion: configura GOOGLE_APPLICATION_CREDENTIALS fuera de este archivo

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCOUNT_ID=123456789012
AWS_DATA_LAKE_BUCKET=abp-data-lake-juanpablo
AWS_DATA_LAKE_PREFIX=iot-data
DATA_LAKE_LOCAL_PATH=data_lake

# AWS Disaster Recovery Configuration
AWS_DR_REGION=us-west-2

# Optional: Direct MongoDB Connection (for testing with local MongoDB)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=
# MONGODB_PASSWORD=

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False

# Data Generation Configuration
DATA_GENERATION_BATCH_SIZE=1000
DATA_GENERATION_TARGET_GB=50
